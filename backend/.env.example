# Google Cloud Platform
GOOGLE_CLOUD_PROJECT=ipl-crowd-mgmt-2026
# Optional when Application Default Credentials are available.
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini AI
GOOGLE_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Firestore
FIRESTORE_DATABASE=(default)

# Pub/Sub
PUBSUB_TOPIC=crowd-telemetry
PUBSUB_SUBSCRIPTION=crowd-telemetry-push

# BigQuery
BIGQUERY_DATASET=crowd_analytics
BIGQUERY_TABLE=telemetry_events

# Cloud Storage
GCS_BUCKET=ipl-crowd-mgmt-archive

# Application
STADIUM_ID=chinnaswamy_stadium
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Required for protected admin endpoints.
# Generate a strong local value before copying this file to .env.
ADMIN_API_KEY=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller has custom admin claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Stadium sub-collections rules
    match /stadiums/{stadiumId} {
      allow read: if true; // Public read access for spectators to view dashboard data
      allow write: if isAdmin();

      // Gate status rules
      match /gates/{gateId} {
        allow read: if true;
        allow write: if isAdmin(); // Only security admin can modify gate configurations
      }

      // Crowdsourced spectator reports rules (V-06: hardened)
      match /reports/{reportId} {
        allow read: if true;
        // Spectators can create reports but must be authenticated and fields are validated
        allow create: if request.auth != null
          && request.resource.data.reporter_type == 'spectator'
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.keys().hasAll(['message', 'reporter_type', 'zone_id']);
        allow update, delete: if isAdmin();
      }

      // Evacuation state rules
      match /evacuation/{document} {
        allow read: if true;
        allow write: if isAdmin(); // Strictly admin write control
      }
    }
  }
}
